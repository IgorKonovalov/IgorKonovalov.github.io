---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { getLocale, postHref } from '../lib/postUrl';
import { getLocaleFromPath, localizePath, pageI18n, t } from '../i18n/ui';
import { tagCounts, tagHref } from '../lib/tags';

const locale = getLocaleFromPath(Astro.url.pathname);
const { switchHref, alternates } = pageI18n(Astro.url.pathname);
const dateLocale = locale === 'ru' ? 'ru-RU' : 'en-GB';
const posts = await getCollection('blog');
const sortedPosts = posts
  .filter((post) => getLocale(post) === locale)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const postsByYear = new Map<number, typeof sortedPosts>();
for (const post of sortedPosts) {
  const year = post.data.date.getFullYear();
  if (!postsByYear.has(year)) postsByYear.set(year, []);
  postsByYear.get(year)!.push(post);
}

const years = [...postsByYear.keys()].sort((a, b) => b - a);
const tags = tagCounts(sortedPosts);
---

<BaseLayout
  title={t(locale, 'archive.title')}
  switchHref={switchHref}
  alternates={alternates}
>
  <article class="post">
    <header class="post-header">
      <h1 class="post-title">{t(locale, 'archive.title')}</h1>
    </header>

    {
      tags.length > 0 && (
        <nav class="archive-tags" aria-label={t(locale, 'tags.title')}>
          <h2 class="archive-tags__title">
            <a href={localizePath('/tags/', locale)}>
              {t(locale, 'tags.title')}
            </a>
          </h2>
          <ul class="archive-tags__list">
            {tags.map(({ tag, count }) => (
              <li>
                <a class="tag" href={tagHref(tag, locale)}>
                  {tag} <span class="archive-tags__count">{count}</span>
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }

    <div class="post-content">
      {
        years.map((year) => (
          <>
            <h1>{year}</h1>
            <ul>
              {postsByYear.get(year)!.map((post) => (
                <li class="archive-item">
                  {post.data.date.toLocaleDateString(dateLocale, {
                    day: '2-digit',
                    month: 'short',
                  })}{' '}
                  &middot; <a href={postHref(post)}>{post.data.title}</a>
                </li>
              ))}
            </ul>
          </>
        ))
      }
      {years.length === 0 && <p>{t(locale, 'noPosts')}</p>}
    </div>
  </article>
</BaseLayout>

<style>
  .archive-tags {
    margin-bottom: var(--space-8);
  }

  .archive-tags__title {
    font-size: var(--text-lg);
    margin: 0 0 var(--space-3);
  }

  .archive-tags__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .archive-tags__list > li {
    margin: 0;
  }

  .archive-tags__count {
    opacity: 0.7;
  }

  .archive-item {
    line-height: var(--leading-normal);
    margin-bottom: var(--space-1);
  }
</style>
