---
// The headline counts at each post's cut-off as small multiples: one mini
// column chart per measure, each on its own scale (the measures share no unit),
// with every value printed on its column.
import '../../styles/viz.css';
import { progress, type SnapshotId } from '../../data/d2recon';

interface Props {
  title: string;
  sub?: string;
  note?: string;
  lang?: 'en' | 'ru';
  /** Cut-offs to compare, oldest first; all three by default. */
  snapshots?: SnapshotId[];
  /** Measures to show (keys of `progress`); all by default. */
  keys?: string[];
}

const { title, sub, note, lang = 'en', snapshots, keys } = Astro.props;

const t = {
  en: {
    snaps: {
      d1: 'day 1',
      d3: 'day 3',
      d4: 'day 4',
      d6: 'day 6',
      d8: 'day 8',
      d11: 'day 11',
      d17: 'day 17',
    } as Record<SnapshotId, string>,
    labels: {
      reviewed:
        'Reviewed specs (28 rows to day 4, 29 on day 6, 35 on day 8, 36 on day 11, 42 on day 17)',
      confirmed: '[C] confirmed claims in findings',
      inferred: '[I] inferred claims in findings',
      symbols: 'Named addresses in Game.exe',
      tools: 'Python tools',
      plans: 'Closed plans',
    } as Record<string, string>,
  },
  ru: {
    snaps: {
      d1: 'день 1',
      d3: 'день 3',
      d4: 'день 4',
      d6: 'день 6',
      d8: 'день 8',
      d11: 'день 11',
      d17: 'день 17',
    } as Record<SnapshotId, string>,
    labels: {
      reviewed:
        'Спецификации после ревью (28 строк до дня 4, 29 в день 6, 35 в день 8, 36 в день 11, 42 в день 17)',
      confirmed: '[C] подтверждённые утверждения в находках',
      inferred: '[I] выведенные утверждения в находках',
      symbols: 'Именованные адреса в Game.exe',
      tools: 'Инструменты на Python',
      plans: 'Закрытые планы',
    } as Record<string, string>,
  },
}[lang];

const snaps: SnapshotId[] = snapshots ?? ['d1', 'd3', 'd4', 'd6'];
const measures = keys ? progress.filter((m) => keys.includes(m.key)) : progress;
const fmt = (n: number) => n.toLocaleString(lang === 'ru' ? 'ru-RU' : 'en-US');
---

<figure class="viz viz-wide progress">
  <p class="viz-title">{title}</p>
  {sub && <p class="viz-sub">{sub}</p>}
  <div class="pm-grid">
    {
      measures.map((m) => {
        const top = Math.max(...snaps.map((s) => m.values[s]));
        return (
          <section class="pm-card" aria-label={t.labels[m.key]}>
            <p class="pm-label">{t.labels[m.key]}</p>
            <div class="pm-cols" style={`--pm-n: ${snaps.length}`}>
              {snaps.map((s, i) => (
                <div
                  class="pm-col"
                  title={`${t.snaps[s]}: ${fmt(m.values[s])}`}
                >
                  <span class="pm-value">{fmt(m.values[s])}</span>
                  <span
                    class={`pm-bar pm-bar-${i === snaps.length - 1 ? 3 : Math.min(i + 1, 2)}`}
                    style={`height: max(2px, calc((100% - 1.2rem) * ${m.values[s] / top}))`}
                  />
                  <span class="pm-snap">{t.snaps[s]}</span>
                </div>
              ))}
            </div>
          </section>
        );
      })
    }
  </div>
  {note && <p class="viz-note">{note}</p>}
</figure>

<style>
  .pm-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
    gap: var(--space-4);
  }
  .pm-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--space-2);
  }
  .pm-label {
    margin: 0;
    font-size: var(--text-sm);
    line-height: var(--leading-tight);
    color: var(--color-text-secondary);
  }
  .pm-cols {
    display: grid;
    grid-template-columns: repeat(var(--pm-n), 1fr);
    gap: var(--space-2);
    align-items: end;
    height: 120px;
    border-bottom: 1px solid var(--viz-axis);
  }
  .pm-col {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    align-items: center;
    height: 100%;
  }
  .pm-bar {
    width: min(24px, 100%);
    border-radius: 4px 4px 0 0;
  }
  /* Older snapshots recede: lighter steps of the same ramp. */
  .pm-bar-1 {
    background: var(--viz-step-1);
  }
  .pm-bar-2 {
    background: var(--viz-step-2);
  }
  .pm-bar-3 {
    background: var(--viz-step-4);
  }
  .pm-value {
    margin-bottom: 2px;
    font-size: var(--text-xs);
    font-variant-numeric: tabular-nums;
    color: var(--color-text-primary);
  }
  .pm-snap {
    position: absolute;
    bottom: -1.4rem;
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    white-space: nowrap;
  }
  .pm-card {
    padding-bottom: 1.4rem;
  }
</style>
