---
// A 2D slice of what the voxel engine keeps around the camera: full detail
// near it, coarser copies (mips) further out, nothing beyond. The reader
// moves the camera with the pointer or the arrow keys.
// Logic: src/scripts/demos/mip-ring.ts.
import '../../styles/viz.css';

interface Props {
  lang?: 'en' | 'ru';
}

const { lang = 'en' } = Astro.props;
const t =
  lang === 'ru'
    ? {
        title: 'Что движок хранит вокруг камеры',
        sub: 'Водите курсором (или стрелками) — камера, чёрная точка, пойдёт за ним. Рядом с ней мир во всех деталях, дальше — всё более грубые копии, ещё дальше — ничего. Квадрат — чанк; цвет рамки — уровень детализации.',
        rings: 'показывать уровни',
        kept: 'хранится клеток',
        full: 'без мипов было бы клеток',
        alt: 'Срез пещеры, где вокруг движущейся точки камеры порода нарисована мелкими вокселями, дальше — всё более крупными блоками, а за кольцами мира нет. Стрелки двигают камеру.',
        legend: [
          'полная детализация',
          'клетка 2×2',
          'клетка 4×4',
          'клетка 8×8',
        ],
        note: 'Чанк здесь 16 вокселей, а не 64, и кольца уменьшены, чтобы всё поместилось в срез. Правило мипа как в движке: клетка твёрдая, если твёрд хоть один воксель под ней, и берёт самый частый материал.',
      }
    : {
        title: 'What the engine keeps around the camera',
        sub: 'Move the pointer (or use the arrow keys) and the camera, the black dot, follows. Near it the world is kept in full detail, further out as coarser and coarser copies, and beyond that not at all. Each square is a chunk; its frame colour is its level of detail.',
        rings: 'show the levels',
        kept: 'cells kept',
        full: 'without mips it would be',
        alt: 'A slice of a cave where, around a moving camera point, the rock is drawn in small voxels, then in larger and larger blocks further out, and beyond the rings there is no world at all. Arrow keys move the camera.',
        legend: ['full detail', 'cell of 2×2', 'cell of 4×4', 'cell of 8×8'],
        note: 'A chunk here is 16 voxels, not 64, and the rings are smaller, so that it fits a slice. The mip rule is the engine’s: a cell is solid if any voxel under it is, and takes the most common material.',
      };
const swatches = ['--viz-2', '--viz-step-3', '--viz-step-2', '--viz-step-1'];
---

<figure
  class="viz viz-wide mip-ring"
  data-mip-ring
  data-lang={lang}
  data-labels={JSON.stringify(t)}
>
  <p class="viz-title">{t.title}</p>
  <p class="viz-sub">{t.sub}</p>
  <ul class="viz-legend">
    {
      t.legend.map((label, i) => (
        <li>
          <span class="viz-swatch" style={`background: var(${swatches[i]})`} />
          {label}
        </li>
      ))
    }
  </ul>
  <canvas width="1152" height="576" tabindex="0" role="img" aria-label={t.alt}
  ></canvas>
  <div class="mr-controls">
    <p class="mr-counter"></p>
    <label><input type="checkbox" data-act="rings" checked /> {t.rings}</label>
  </div>
  <p class="viz-note">{t.note}</p>
</figure>

<style>
  canvas {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--radius-md);
    cursor: crosshair;
    touch-action: none;
  }
  canvas:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }
  .mr-controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-4);
    margin-top: var(--space-3);
    font-size: var(--text-sm);
  }
  .mr-counter {
    margin: 0;
    flex: 1 1 100%;
    font-family: var(--font-mono);
    color: var(--color-text-secondary);
  }
</style>

<script>
  import { mipRing } from '../../scripts/demos/mip-ring';

  for (const el of document.querySelectorAll<HTMLElement>('[data-mip-ring]')) {
    mipRing(el);
  }
</script>
