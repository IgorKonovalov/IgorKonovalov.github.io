---
// A 2D slice of digging in the voxel engine: each dig reports what it took
// per material, and rock that loses its support falls as one body.
// Logic: src/scripts/demos/cave-collapse.ts.
import '../../styles/viz.css';

interface Props {
  lang?: 'en' | 'ru';
}

const { lang = 'en' } = Astro.props;
const t =
  lang === 'ru'
    ? {
        title: 'Копать и обрушивать',
        sub: 'Нажмите или проведите по породе, чтобы копать (с клавиатуры: стрелки и Enter). Всё, что больше не держится за пол или стены, падает целым куском. Попробуйте подкопать свод.',
        reset: 'Новая пещера',
        last: 'последний раскоп',
        fell: 'упало вокселей',
        materials: ['порода', 'тёмная порода', 'руда', 'кристалл'],
        none: '—',
        alt: 'Срез пещеры с потолком, колоннами и навесами; там, где копает читатель, появляются ямы, и отрезанные куски породы падают вниз. Стрелки двигают круг раскопа, Enter копает.',
        note: 'Правило опоры упрощено до двух измерений: держится воксель, который через цепочку соседей по стороне (не по углу) доходит до пола или боковой стены. Раздавливания в срезе нет.',
      }
    : {
        title: 'Dig, and watch it fall',
        sub: 'Click or drag on the rock to dig (keyboard: arrow keys and Enter). Anything no longer holding on to the floor or the walls falls as one piece. Try undercutting the ceiling.',
        reset: 'New cave',
        last: 'last dig',
        fell: 'voxels fallen',
        materials: ['rock', 'dark rock', 'ore', 'crystal'],
        none: '—',
        alt: 'A slice of a cave with a ceiling, pillars and overhangs; where the reader digs, holes open, and pieces of rock cut loose fall down. Arrow keys move the dig circle, Enter digs.',
        note: 'The support rule is cut down to two dimensions: a voxel holds if a chain of neighbours sharing a side (not a corner) reaches the floor or a side wall. The slice leaves crushing out.',
      };
---

<figure
  class="viz viz-wide cave-collapse"
  data-cave-collapse
  data-labels={JSON.stringify(t)}
>
  <p class="viz-title">{t.title}</p>
  <p class="viz-sub">{t.sub}</p>
  <canvas width="960" height="600" tabindex="0" role="img" aria-label={t.alt}
  ></canvas>
  <div class="cc-controls">
    <p class="cc-counter"></p>
    <button type="button" data-act="reset">{t.reset}</button>
  </div>
  <p class="viz-note">{t.note}</p>
</figure>

<style>
  canvas {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--radius-md);
    cursor: crosshair;
    touch-action: none;
  }
  canvas:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }
  .cc-controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-4);
    margin-top: var(--space-3);
    font-size: var(--text-sm);
  }
  .cc-counter {
    margin: 0;
    flex: 1 1 20rem;
    font-family: var(--font-mono);
    color: var(--color-text-secondary);
  }
</style>

<script>
  import { caveCollapse } from '../../scripts/demos/cave-collapse';

  for (const el of document.querySelectorAll<HTMLElement>(
    '[data-cave-collapse]',
  )) {
    caveCollapse(el);
  }
</script>
