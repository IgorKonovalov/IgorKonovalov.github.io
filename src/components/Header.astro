---
import {
  getLocaleFromPath,
  localeHome,
  localizePath,
  otherLocale,
  t,
  toggleLocalePath,
} from '../i18n/ui';

interface Props {
  width?: 'default' | 'wide';
  switchHref?: string;
}

const { width = 'default', switchHref } = Astro.props;

const locale = getLocaleFromPath(Astro.url.pathname);
const homeHref = localeHome(locale);
const navLinks = [
  { title: t(locale, 'nav.about'), url: localizePath('/about/', locale) },
  { title: t(locale, 'nav.archive'), url: localizePath('/archive/', locale) },
];
// Language toggle: a compact two-letter code for the other language; target is
// provided by the page (a real translation) or falls back to the pair path.
const langHref = switchHref ?? toggleLocalePath(Astro.url.pathname);
const langCode = otherLocale(locale).toUpperCase();
---

<header class="site-header" role="banner">
  <div class={`wrapper${width === 'wide' ? ' wrapper-wide' : ''}`}>
    <a class="site-title" rel="author" href={homeHref}>Igor Konovalov</a>

    <nav class="site-nav">
      <input type="checkbox" id="nav-trigger" class="nav-trigger" />
      <label for="nav-trigger">
        <span class="menu-icon">
          <svg viewBox="0 0 18 15" width="18px" height="15px">
            <path
              d="M18,1.484c0,0.82-0.665,1.484-1.484,1.484H1.484C0.665,2.969,0,2.304,0,1.484l0,0C0,0.665,0.665,0,1.484,0 h15.032C17.335,0,18,0.665,18,1.484L18,1.484z M18,7.516C18,8.335,17.335,9,16.516,9H1.484C0.665,9,0,8.335,0,7.516l0,0 c0-0.82,0.665-1.484,1.484-1.484h15.032C17.335,6.031,18,6.696,18,7.516L18,7.516z M18,13.516C18,14.335,17.335,15,16.516,15H1.484 C0.665,14.969,0,14.304,0,13.516l0,0c0-0.82,0.665-1.484,1.484-1.484h15.032C17.335,12.031,18,12.696,18,13.516L18,13.516z"
              fill="currentColor"></path>
          </svg>
        </span>
      </label>

      <div class="trigger">
        {
          navLinks.map((link) => (
            <a class="page-link" href={link.url}>
              {link.title}
            </a>
          ))
        }
        <a
          class="page-link lang-switch"
          href={langHref}
          hreflang={otherLocale(locale)}
          aria-label={`Switch language to ${otherLocale(locale).toUpperCase()}`}
        >
          {langCode}
        </a>
        <button
          type="button"
          class="theme-toggle"
          aria-label="Toggle dark and light theme"
        >
          <span
            class="theme-toggle__icon theme-toggle__icon--light"
            aria-hidden="true">☀️</span
          >
          <span
            class="theme-toggle__icon theme-toggle__icon--dark"
            aria-hidden="true">🌙</span
          >
        </button>
      </div>
    </nav>
  </div>
</header>

<script is:inline>
  // Toggle the theme and persist the choice. The effective current theme is the
  // explicit data-theme if set, otherwise whatever the OS prefers.
  (() => {
    const btn = document.querySelector('.theme-toggle');
    if (!btn) return;
    btn.addEventListener('click', () => {
      const root = document.documentElement;
      const current =
        root.getAttribute('data-theme') ||
        (window.matchMedia('(prefers-color-scheme: dark)').matches
          ? 'dark'
          : 'light');
      const next = current === 'dark' ? 'light' : 'dark';
      root.setAttribute('data-theme', next);
      localStorage.setItem('theme', next);
    });
  })();
</script>

<style>
  /* Align title and nav on a shared baseline (desktop) */
  @media screen and (min-width: 641px) {
    .site-header .wrapper {
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .site-header .site-title,
    .site-header .site-nav {
      float: none;
    }

    /* The .wrapper clearfix ::after would otherwise become a third flex item
       and get pushed to the right by space-between, stranding the nav in the
       middle. Drop it in the flex context so the nav hugs the column edge. */
    .site-header .wrapper::after {
      display: none;
    }

    /* Lay the nav out as a row so its links hug the right edge as one group. */
    .site-header .trigger {
      display: flex;
      align-items: center;
    }
  }

  /* Checkbox hack for mobile nav toggle */
  .nav-trigger {
    display: none;
  }

  .nav-trigger:checked ~ .trigger {
    display: block;
    padding-bottom: 5px;
  }

  /* Language switch: a compact code set apart from the page links, pinned to
     the far right (the column's right edge). */
  .lang-switch {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    letter-spacing: 0.04em;
    color: var(--color-text-muted);
  }

  .lang-switch:hover,
  .lang-switch:focus-visible {
    color: var(--color-accent);
  }

  /* Theme toggle: emoji-only button. The icon shown reflects the *current*
     theme, driven entirely by CSS so it never flashes the wrong glyph. */
  .theme-toggle {
    margin-left: var(--space-4);
    padding: 2px;
    background: none;
    border: 0;
    cursor: pointer;
    font-size: var(--text-lg);
    line-height: 1;
    border-radius: var(--radius-sm);
    opacity: 0.85;
    transition:
      opacity var(--transition-fast),
      transform var(--transition-fast);
  }

  .theme-toggle:hover,
  .theme-toggle:focus-visible {
    opacity: 1;
    transform: scale(1.1);
    outline: none;
  }

  /* Default / light: show the sun, hide the moon. */
  .theme-toggle__icon--dark {
    display: none;
  }

  /* OS dark (unless the user forced light): show the moon. */
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .theme-toggle__icon--light {
      display: none;
    }
    :global(:root:not([data-theme='light'])) .theme-toggle__icon--dark {
      display: inline;
    }
  }

  /* Explicit overrides from the toggle win in either direction. */
  :global(:root[data-theme='dark']) .theme-toggle__icon--light {
    display: none;
  }
  :global(:root[data-theme='dark']) .theme-toggle__icon--dark {
    display: inline;
  }
  :global(:root[data-theme='light']) .theme-toggle__icon--light {
    display: inline;
  }
  :global(:root[data-theme='light']) .theme-toggle__icon--dark {
    display: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .theme-toggle {
      transition: none;
    }
    .theme-toggle:hover,
    .theme-toggle:focus-visible {
      transform: none;
    }
  }
</style>
