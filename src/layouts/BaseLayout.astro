---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SEO from '../components/SEO.astro';
import { getLocaleFromPath, toggleLocalePath, type Locale } from '../i18n/ui';
import '../styles/tokens.css';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  type?: 'website' | 'article';
  width?: 'default' | 'wide';
  alternates?: Partial<Record<Locale, string>>;
  switchHref?: string;
}

const {
  title,
  description,
  type,
  width = 'default',
  alternates,
  switchHref,
} = Astro.props;
const locale = getLocaleFromPath(Astro.url.pathname);
// The language toggle target. Static pages pass an explicit switchHref;
// otherwise fall back to the same path in the other locale.
const langHref = switchHref ?? toggleLocalePath(Astro.url.pathname);
const feedHref = locale === 'ru' ? '/ru/rss.xml' : '/rss.xml';
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <SEO
      title={title}
      description={description}
      type={type}
      alternates={alternates}
    />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Igor Konovalov"
      href={feedHref}
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;0,8..60,700;1,8..60,400&family=Source+Sans+3:wght@300;400;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <Header width={width} switchHref={langHref} />
    <main class="page-content" aria-label="Content">
      <div class={`wrapper${width === 'wide' ? ' wrapper-wide' : ''}`}>
        <slot />
      </div>
    </main>
    <Footer width={width} />
    <script is:inline type="module">
      // Load mermaid only when a diagram is present on the page, from CDN, so
      // no build-time dependency is added and non-diagram pages ship no extra JS.
      if (document.querySelector('.mermaid')) {
        const { default: mermaid } =
          await import('https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.esm.min.mjs');
        mermaid.initialize({
          startOnLoad: false,
          securityLevel: 'strict',
          theme: 'neutral',
        });
        await mermaid.run({ querySelector: '.mermaid' });
      }
    </script>
  </body>
</html>
