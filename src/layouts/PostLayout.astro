---
import BaseLayout from './BaseLayout.astro';
import { DATE_LOCALE, getLocaleFromPath, t, type Locale } from '../i18n/ui';
import { DEFAULT_OG_IMAGE, blogPostingSchema } from '../lib/seo';

interface Props {
  title: string;
  date: Date;
  tags?: string[];
  description?: string;
  switchHref?: string;
  alternates?: Partial<Record<Locale, string>>;
  /** Featured image, also used as the post's social card. */
  image?: string;
}

const { title, date, tags, description, switchHref, alternates, image } =
  Astro.props;
const locale = getLocaleFromPath(Astro.url.pathname);
const ogImage = image ?? DEFAULT_OG_IMAGE;
const schema = [
  blogPostingSchema({
    title,
    description,
    date,
    tags,
    url: Astro.url.pathname,
    image: ogImage,
    locale,
  }),
];
---

<BaseLayout
  title={title}
  description={description}
  type="article"
  switchHref={switchHref}
  alternates={alternates}
  image={ogImage}
  imageAlt={title}
  schema={schema}
>
  <article class="post">
    <header class="post-header">
      <h1 class="post-title">{title}</h1>
      <p class="post-meta">
        {t(locale, 'post.postedOn')}{' '}
        {
          date.toLocaleDateString(DATE_LOCALE[locale], {
            year: 'numeric',
            month: 'long',
            day: 'numeric',
          })
        }
      </p>
      {
        tags && tags.length > 0 && (
          <div class="post-tags">
            {tags.map((tag) => (
              <span class="tag">{tag}</span>
            ))}
          </div>
        )
      }
    </header>

    <div class="post-content">
      <slot />
    </div>
  </article>
</BaseLayout>

<style>
  .post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-3);
  }
</style>
