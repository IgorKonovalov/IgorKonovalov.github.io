---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { getLocale, postHref } from '../lib/postUrl';
import { DATE_LOCALE, getLocaleFromPath, t } from '../i18n/ui';

const locale = getLocaleFromPath(Astro.url.pathname);
const posts = await getCollection('blog');
const sortedPosts = posts
  .filter((post) => getLocale(post) === locale)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout width="wide">
  <section class="home-intro">
    <h1 class="home-title">{t(locale, 'home.title')}</h1>
    <p class="home-tagline">{t(locale, 'home.tagline')}</p>
  </section>

  <ul class="post-grid">
    {
      sortedPosts.map((post) => (
        <li>
          <a class="post-card" href={postHref(post)}>
            <div class="post-card__head">
              {post.data.tags?.[0] && (
                <span class="tag">{post.data.tags[0]}</span>
              )}
              <time
                class="post-card__date"
                datetime={post.data.date.toISOString()}
              >
                {post.data.date.toLocaleDateString(DATE_LOCALE[locale], {
                  year: 'numeric',
                  month: 'short',
                  day: 'numeric',
                })}
              </time>
            </div>
            <h2 class="post-card__title">{post.data.title}</h2>
            {post.data.description && (
              <p class="post-card__desc">{post.data.description}</p>
            )}
            <span class="post-card__more">
              {t(locale, 'card.read')}
              <span class="post-card__arrow"> &rarr;</span>
            </span>
          </a>
        </li>
      ))
    }
    {sortedPosts.length === 0 && <p>{t(locale, 'noPosts')}</p>}
  </ul>
</BaseLayout>

<style>
  /* --- Intro ------------------------------------------------------------- */
  .home-intro {
    max-width: 42rem;
    margin-bottom: var(--space-12);
  }

  .home-title {
    font-size: var(--text-4xl);
    line-height: var(--leading-tight);
    letter-spacing: -0.5px;
    margin-bottom: var(--space-4);
  }

  .home-tagline {
    font-size: var(--text-lg);
    color: var(--color-text-secondary);
    line-height: var(--leading-normal);
    margin: 0;
  }

  /* --- Card grid --------------------------------------------------------- */
  .post-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: var(--space-6);
  }

  .post-grid > li {
    margin: 0;
  }

  .post-card {
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    padding: var(--space-6);
    background-color: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    color: inherit;
    text-decoration: none;
    transition:
      transform var(--transition-normal),
      box-shadow var(--transition-normal),
      border-color var(--transition-normal);
  }

  /* Gradient hairline that reveals on hover */
  .post-card::before {
    content: '';
    position: absolute;
    inset: 0 0 auto 0;
    height: 3px;
    background: linear-gradient(
      90deg,
      var(--color-accent),
      var(--color-accent-warm)
    );
    opacity: 0;
    transition: opacity var(--transition-normal);
  }

  /* Soft generative-art motif in the corner */
  .post-card::after {
    content: '';
    position: absolute;
    top: -50px;
    right: -50px;
    width: 140px;
    height: 140px;
    background: radial-gradient(
      circle at center,
      var(--color-accent-subtle) 0%,
      transparent 70%
    );
    opacity: 0.7;
    pointer-events: none;
    transition: transform var(--transition-normal);
  }

  .post-card:hover,
  .post-card:focus-visible {
    transform: translateY(-4px);
    box-shadow: var(--shadow-md);
    border-color: var(--color-border-hover);
    outline: none;
  }

  .post-card:hover::before,
  .post-card:focus-visible::before {
    opacity: 1;
  }

  .post-card:hover::after,
  .post-card:focus-visible::after {
    transform: scale(1.15);
  }

  .post-card__head {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    margin-bottom: var(--space-3);
  }

  .post-card__date {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .post-card__title {
    position: relative;
    font-size: var(--text-2xl);
    line-height: var(--leading-tight);
    margin: 0 0 var(--space-2);
    transition: color var(--transition-fast);
  }

  .post-card:hover .post-card__title,
  .post-card:focus-visible .post-card__title {
    color: var(--color-accent);
  }

  .post-card__desc {
    position: relative;
    flex: 1;
    color: var(--color-text-secondary);
    font-size: var(--text-base);
    line-height: var(--leading-normal);
    margin: 0 0 var(--space-4);
  }

  .post-card__more {
    position: relative;
    align-self: flex-start;
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-accent);
  }

  .post-card__arrow {
    display: inline-block;
    transition: transform var(--transition-fast);
  }

  .post-card:hover .post-card__arrow,
  .post-card:focus-visible .post-card__arrow {
    transform: translateX(4px);
  }

  @media screen and (max-width: 640px) {
    .home-title {
      font-size: var(--text-3xl);
    }

    .home-intro {
      margin-bottom: var(--space-8);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .post-card,
    .post-card::after,
    .post-card__arrow {
      transition: none;
    }
    .post-card:hover,
    .post-card:focus-visible {
      transform: none;
    }
  }
</style>
