---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { getLocale, postHref } from '../lib/postUrl';
import { getLocaleFromPath, t } from '../i18n/ui';

const locale = getLocaleFromPath(Astro.url.pathname);
const dateLocale = locale === 'ru' ? 'ru-RU' : 'en-GB';
const posts = await getCollection('blog');
const sortedPosts = posts
  .filter((post) => getLocale(post) === locale)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const postsByYear = new Map<number, typeof sortedPosts>();
for (const post of sortedPosts) {
  const year = post.data.date.getFullYear();
  if (!postsByYear.has(year)) postsByYear.set(year, []);
  postsByYear.get(year)!.push(post);
}

const years = [...postsByYear.keys()].sort((a, b) => b - a);
---

<BaseLayout title={t(locale, 'archive.title')}>
  <article class="post">
    <header class="post-header">
      <h1 class="post-title">{t(locale, 'archive.title')}</h1>
    </header>

    <div class="post-content">
      {
        years.map((year) => (
          <>
            <h1>{year}</h1>
            <ul>
              {postsByYear.get(year)!.map((post) => (
                <li class="archive-item">
                  {post.data.date.toLocaleDateString(dateLocale, {
                    day: '2-digit',
                    month: 'short',
                  })}{' '}
                  &middot; <a href={postHref(post)}>{post.data.title}</a>
                </li>
              ))}
            </ul>
          </>
        ))
      }
      {years.length === 0 && <p>{t(locale, 'noPosts')}</p>}
    </div>
  </article>
</BaseLayout>

<style>
  .archive-item {
    line-height: var(--leading-normal);
    margin-bottom: var(--space-1);
  }
</style>
